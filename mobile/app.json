{
  "expo": {
    "scheme": "spotter-weightlifting",
    "name": "Spotter – Weightlifting Log",
    "slug": "Spotter",
    "version": "2.0",
    "orientation": "portrait",
    "icon": "./assets/icons/ios-light.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.aross.spotter",
      "usesAppleSignIn": true,
      "deploymentTarget": "26.0",
      "icon": {
        "dark": "./assets/icons/ios-dark.png",
        "light": "./assets/icons/ios-light.png",
        "tinted": "./assets/icons/ios-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIDeviceFamily": [1],
        "UIRequiresFullScreen": true,
        "CFBundleDisplayName": "Spotter",
        "NSPhotoLibraryAddUsageDescription": "Spotter saves your workout screenshots to your Photos.",
        "NSPhotoLibraryUsageDescription": "Spotter saves your workout screenshots to your Photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "app.aross.spotter"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "server",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-build-properties",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.216743842353-e8ab810c68h93uuc3crkqjqgrj6qiqnj"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-icon-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#807BCF",
          "dark": {
            "image": "./assets/icons/splash-icon-dark.png",
            "backgroundColor": "#1E1E1E"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      ["expo-apple-authentication"]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "84762c8f-5847-45ae-bb90-317dbbc9c6ea"
      }
    }
  }
}
